{
  "name": "@figmog/react",
  "version": "0.0.0",
  "private": true,
  "description": "Screenshot runner and Figma comparison images for figmog's React verification slice.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "figmog-shot": "dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build && node --test --test-concurrency=1 \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "pixelmatch": "8.0.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "typescript": "7.0.2"
  }
}
