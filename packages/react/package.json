{
  "name": "@figmog/react",
  "version": "0.0.0",
  "private": true,
  "description": "figmog's React tooling: the dev-only Vite plugin (attributes and the local bridge to figmog) and the screenshot runner for verification.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "figmog-shot": "dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./vite": "./dist/src/vite.js",
    "./client": "./dist/src/client.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build && node --test --test-concurrency=1 \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "pixelmatch": "8.0.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0"
  },
  "peerDependencies": {
    "vite": "^8.3.5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
